<Project Sdk="Microsoft.NET.Sdk">

  <!-- Dependency-free test runner: compiles the app's pure Core/ sources directly and
       exits non-zero when any check fails.  Run with:  dotnet run -c Release -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SurvivalHud.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\SurvivalHud\Core\**\*.cs" LinkBase="Core" />
  </ItemGroup>

</Project>
