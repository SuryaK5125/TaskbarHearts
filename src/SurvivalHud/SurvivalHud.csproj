<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TaskbarHearts</AssemblyName>
    <RootNamespace>SurvivalHud</RootNamespace>
    <Version>1.0.0</Version>
    <Product>Taskbar Hearts</Product>
    <AssemblyTitle>Taskbar Hearts</AssemblyTitle>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- Portable single-file x64 build: "dotnet publish -c Release" -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Left uncompressed on purpose: a compressed bundle is unpacked into RAM on every start (~90 MB more memory). -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>

    <!-- Background-utility tuning: smaller footprint, no background GC thread -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
    <!-- WPF controls resolve en-US cultures when Settings is opened. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.IO" />
    <!-- Ask the GC to favour a small heap over speed (0 = default … 9 = most compact). -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
  </ItemGroup>

</Project>
